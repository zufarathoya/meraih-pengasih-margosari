---
import BaseLayout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { Image } from 'astro:assets';

const programs = await getCollection("posts");
---

<BaseLayout title="Home">
  <main class="container mx-auto px-6 py-12 flex-grow">
    <div class="text-center">
      <h1 class="text-3xl font-bold mb-3 md:text-5xl text-green-600">
        <span
          class="bg-clip-text text-transparent bg-gradient-to-r from-yellow-600 to-green-600"
        >
          Program Kerja Kami
        </span>
      </h1>
    </div>
    <h1 class="text-xl mb-7 mt-7">
      Berikut ini adalah program kerja yang kami lakukan selama kegiatan KKN ini
      berlangsung yang bertemakan Pengembangan Ekowisata dan Ketahanan Pangan di
      Kalurahan Margosari
    </h1>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        programs.map(prog => (
          <a 
        href={`/proker/${prog.slug}`}
          >
            <div
          class="bg-white rounded-xl shadow hover:shadow-lg transition p-4 flex flex-col mb-7 md:mb-0"
            >
              <div class="relative w-full h-56 mb-4">
                <Image
                  src={prog.data.image}
                  alt={prog.data.title}
                  class="rounded-lg object-cover w-full h-full"
                  loading="lazy"
                />
              </div>
              <h3 class="text-xl font-bold text-gray-800">{prog.data.title}</h3>
              <span class="text-sm text-gray-500">{prog.data.date}</span>
              <p class="text-gray-600 mt-2 flex-grow">{prog.data.description}</p>
            </div>
          </a>
        ))
      }
    </div>
  </main>
</BaseLayout>

