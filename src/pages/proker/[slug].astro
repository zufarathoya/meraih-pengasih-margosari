---
import { getCollection, CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/Layout.astro";

export const getStaticPaths = async () => {
  const posts = await getCollection("posts");
  const paths = posts.map((post) => {
    return {
      params: {
        slug: post.slug,
      },
      props: {
        post,
      },
    };
  });
  return paths;
};

type Post = {
  posts: CollectionEntry<"posts">;
};

const { post } = Astro.props;
const { Content } = await post.render();
---

<BaseLayout title={post.data.title}>
  <main class="container w-auto mx-auto px-2 py-12 flex flex-grow md:w-max">
    <article class="prose lg:prose-xl">
      <h1 class="text-center bg-clip-text text-transparent bg-gradient-to-r from-yellow-600 to-green-600">{post.data.title}</h1>
      <p class="text-sm text-gray-500 mb-6">{post.data.date}</p>
      <Image
        src={post.data.image}
        alt={post.data.title}
        class="rounded-lg mb-6"
      />
      <Content />
    </article>
  </main>
</BaseLayout>
