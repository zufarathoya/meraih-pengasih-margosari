---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

type Program = CollectionEntry<"posts">; // atau nama koleksi kamu
interface Props {
  programs: Program[];
}
const { programs } = Astro.props as Props;
---

<div class="container mx-auto px-4">
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-xl font-semibold">Program Unggulan</h2>
  </div>

  <div class="flex gap-4 overflow-x-auto pb-2">
    {programs?.map((prog) => (
      <div class="bg-white rounded-xl shadow hover:shadow-lg transition p-4 flex flex-col w-80 flex-shrink-0">
        <div class="relative w-full h-56 mb-4">
          <Image
            src={prog.data.image}
            alt={prog.data.title}
            class="rounded-lg object-cover w-full h-full"
            loading="lazy"
          />
        </div>
        <h3 class="text-xl font-bold text-gray-800">{prog.data.title}</h3>
        <span class="text-sm text-gray-500">{prog.data.date}</span>
        <p class="text-gray-600 mt-2 text-sm line-clamp-4">{prog.data.description}</p>
      </div>
    ))}
  </div>
</div>

<style is:global>
  /* opsional: sembunyikan scrollbar */
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>

